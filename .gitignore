# Solver binary differs per OS (macOS/Linux: bin/solve_sudoku, Windows: bin/solve_sudoku.exe).
# Everyone copies the bin/ folder from their own course bundle.
bin/

# Editor settings contain machine-specific paths (e.g. your conda interpreter).
.vscode/
.idea/

# Python bytecode and notebook checkpoints
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS / Windows metadata
.DS_Store
._*
__MACOSX/
Thumbs.db

# Generated by running games or building submissions
*.pkl
*.zip
*.log
